# Environment to target: local | review | test | production
ENVIRONMENT=local

# Required when ENVIRONMENT=review and REVIEW_URL is not set
PR_NUMBER=

# Optional: overrides the review app URL derived from PR_NUMBER
REVIEW_URL=

# Optional: overrides the default local base URL (http://localhost:3000)
LOCAL_URL=

# Optional: overrides the default loadtest base URL (https://localhost:5099)
# Only ever point this at an instance YOU are running with
# ASPNETCORE_ENVIRONMENT=LoadTest - never a shared review/test/production app.
LOADTEST_URL=

# Optional: enables the authenticated journeys (search, school pages, compare
# performance) against a REAL environment (e.g. ENVIRONMENT=test), instead of
# only via LoadTest mode. This is a live session cookie, not a password -
# treat it exactly like one. NEVER commit it, NEVER paste it in chat/PRs/logs.
#
# How to get it: sign in once through a real browser using a dedicated
# test/service DfE Sign-in account (never a real school leader's account),
# completing MFA as normal. Then open DevTools > Application/Storage >
# Cookies and copy the value of the "SAPSec.Auth" cookie. It stays valid via
# sliding expiration as long as the load test keeps making requests, but
# will need refreshing (repeat this step) for a later run once it expires.
SESSION_COOKIE=

# Monitoring (only needed for Grafana Cloud runs)
GRAFANA_CLOUD_TOKEN=
GRAFANA_PROJECT_ID=
