@using SAPSec.Web.Constants
@{
    ViewData[ViewDataKeys.Title] = PageTitles.ErrorNotFound;
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">@ViewData[ViewDataKeys.Title]</h1>
        <p class="govuk-body">
            If you typed the web address, check it is correct.
        </p>
        <p class="govuk-body">
            If you pasted the web address, check you copied the entire address.
        </p>
        <p class="govuk-body">
            If the web address is correct but you cannot view this school, this may be because the school:
        </p>
        <ul class="govuk-list govuk-list--bullet">
            <li>is outside England</li>
            <li>is due to open</li>
            <li>is not a mainstream state-funded primary, secondary, middle or all-through school</li>
            <li>does not assess pupils, for example nursery and infant schools that do not cover key stage 2</li>
            <li>has closed, or changed school type, more than 3 academic years ago</li>
        </ul>

        <h2 class="govuk-heading-m">If you expected to see a school</h2>
        <p class="govuk-body">
            Check the school&rsquo;s details on <a class="govuk-link" rel="noreferrer noopener" target="_blank" href="https://www.get-information-schools.service.gov.uk/">Get Information About Schools (opens in new tab)</a>.
            If you still cannot see the school, contact the support team at <a class="govuk-link" href="mailto:schoolinsights.support@education.gov.uk">schoolinsights.support@education.gov.uk</a>.
        </p>

        @if (Model.ShowErrorCode)
        {
            <p class="govuk-body">
                <strong>Error code:</strong> <code>@Model.ErrorCode</code>
            </p>
        }
        @if (Model.ShowErrorMessage)
        {
            <p class="govuk-body">
                <strong>Error message:</strong> <code class="govuk-body">@Model.ErrorMessage</code>
            </p>
        }
    </div>
</div>