@using Microsoft.AspNetCore.Authorization
@using SAPSec.Web.Authorization
@using SAPSec.Web.Constants
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    ViewData[ViewDataKeys.Title] = PageTitles.ErrorNotFound;
    var canSearchAllSchools = User.Identity is { IsAuthenticated: true }
        && (await AuthorizationService.AuthorizeAsync(User, AuthorizationPolicies.DfeUser)).Succeeded;
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">@ViewData[ViewDataKeys.Title]</h1>
        <p class="govuk-body">
            If you typed the web address, check it is correct.
        </p>
        <p class="govuk-body">
            If you pasted the web address, check you copied the entire address.
        </p>
        <p class="govuk-body">
            @if (canSearchAllSchools)
            {
                <text>You can also <a class="govuk-link" href="@Routes.FindASchool()">search for a school</a> to find the information you need.</text>
            }
            else
            {
                <text>You can also <a class="govuk-link" href="@Routes.UserHome">go back to your start page</a> to find the information you need.</text>
            }
        </p>

        @if (Model.ShowErrorCode)
        {
            <p class="govuk-body">
                <strong>Error code:</strong> <code>@Model.ErrorCode</code>
            </p>
        }
        @if (Model.ShowErrorMessage)
        {
            <p class="govuk-body">
                <strong>Error message:</strong> <code class="govuk-body">@Model.ErrorMessage</code>
            </p>
        }
    </div>
</div>