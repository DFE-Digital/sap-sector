@using SAPSec.Web.ViewModels.Components
@model ClosedSchoolBannerViewModel

@{
    var ariaLabel = Model.Variant == ClosedSchoolBannerVariant.Comparator
        ? "Comparator school closed notice"
        : "Closed school notice";
}

<div class="govuk-inset-text guidance-panel app-closed-school-banner" role="region" aria-label="@ariaLabel">
    @if (!Model.HasSuccessors)
    {
        <p class="govuk-body">This school is closed.</p>
    }
    else if (Model.Successors.Count == 1)
    {
        var successor = Model.Successors[0];
        <p class="govuk-body">
            This school is closed. It is now <a class="govuk-link" href="@successor.Url">@successor.Name</a>.
        </p>
        <p class="govuk-body govuk-!-margin-bottom-0">
            <a class="govuk-link" href="@successor.Url">View data for @successor.Name</a>
        </p>
    }
    else
    {
        <p class="govuk-body">
            This school is closed. It is now @Model.SuccessorNamesJoined.
        </p>
        <p class="govuk-body govuk-!-margin-bottom-0">
            You can view information on the new schools:
        </p>
        <ul class="govuk-list govuk-list--bullet govuk-!-margin-bottom-0">
            @foreach (var successor in Model.Successors)
            {
                <li><a class="govuk-link" href="@successor.Url">View data for @successor.Name</a></li>
            }
        </ul>
    }
</div>
