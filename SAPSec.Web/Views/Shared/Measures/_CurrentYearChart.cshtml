@using System.Text.Json
@using SAPSec.Core.Features.Measures
@using SAPSec.Web.ViewModels.Measures

@model CurrentYearChartViewModel

@{
    var chartData = new
    {
        labels = Model.MeasureInfo.Labels.ToArray(),
        data = Model.Averages.ToArray()
    };
    var hasAnyData = Model.Averages.Any();
    var decimals = Model.MeasureInfo.DataType switch
    {
        MeasureDataType.Score or MeasureDataType.ProgressScore => 1,
        MeasureDataType.ScaledScore or MeasureDataType.DestinationsPercentage => 1,
        MeasureDataType.OverallAbsencePercentage or MeasureDataType.PersistentAbsencePercentage => 2,
        _ => 0
    };
    var (axisMin, axisStep, defaultAxisMax) = Model.MeasureInfo.DataType switch
    {
        MeasureDataType.Score => (0, 30, 90),
        MeasureDataType.OverallAbsencePercentage => (0, 1, 10),
        MeasureDataType.PersistentAbsencePercentage => (0, 5, 30),
        MeasureDataType.ScaledScore => (80, 20, 120),
        _ => (0, 25, 100)
    };
    var maxDataValue = Model.Averages.Where(a => a.HasValue).Select(a => a!.Value).DefaultIfEmpty(0).Max();
    decimal axisMax = maxDataValue > defaultAxisMax
        ? (int)(Math.Ceiling(maxDataValue / axisStep) * axisStep)
        : defaultAxisMax;
    decimal axisMinValue = axisMin;
    decimal axisStepValue = axisStep;

    // Progress scores can be negative with no fixed range, so the axis is worked out from the data
    // and always includes 0 (bars diverge left/right from the 0 baseline).
    if (Model.MeasureInfo.DataType == MeasureDataType.ProgressScore)
    {
        (axisMinValue, axisStepValue, axisMax) = ProgressScoreAxis.For(Model.Averages);
    }
}

<div class="app-measure-chart-container">
    @if (hasAnyData)
    {
          <canvas id="@Model.MeasureInfo.HtmlPrefix-current-year-chart"
                  data-testid="@Model.MeasureInfo.HtmlPrefix-current-year-chart"
                  class="js-chart js-chart--school-measure-bar"
                  data-type="bar"
                  data-show-no-data-labels="true"
                  data-axis-min="@axisMinValue.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)"
                  data-axis-step="@axisStepValue.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)"
                  data-axis-max="@axisMax.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)"
                  data-label-decimals="@decimals"
                  data-tooltip-decimals="@decimals"
                  data-category-percentage="0.6"
                  data-bar-percentage="1"
                  data-bar-thickness="50"
                  data-axis-include-zero="@(Model.MeasureInfo.DataType == MeasureDataType.ProgressScore ? "true" : "false")"
                  data-axis-suffix="@(Model.MeasureInfo.DataType is MeasureDataType.GradePercentage or 
                                                                    MeasureDataType.OverallAbsencePercentage or 
                                                                    MeasureDataType.PersistentAbsencePercentage or
                                                                    MeasureDataType.DestinationsPercentage ? "%" : "")"
                  data-chart="@Html.Raw(JsonSerializer.Serialize(chartData).Replace("\"", "&quot;"))"
                  data-colors="@Html.Raw(JsonSerializer.Serialize(Model.Colors).Replace("\"", "&quot;"))">
           </canvas>
    }
    else
    {
        <p class="govuk-body">No available data</p>
    }
</div>
