@using SAPSec.Web.Constants
@model SAPSec.Web.ViewModels.YourSchoolsViewModel
@{
    ViewData[ViewDataKeys.Title] = PageTitles.YourSchools;
    var hasResults = Model.Results.Length > 0;
}
<link rel="stylesheet" href="~/css/leaflet.css"/>
<link rel="stylesheet" href="~/css/MarkerCluster.css"/>
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l" id="organisation-name">@Model.OrganisationName</span>
        <h1 class="govuk-heading-xl">@PageTitles.YourSchools</h1>
        <p class="govuk-body">
            These are the schools in your @Model.OrganisationTypeDescription. Select a school to view its performance against similar schools.
        </p>
    </div>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds app-filter__results-column">
        @if (hasResults)
        {
            @await Html.PartialAsync("~/Views/SchoolSearch/_SchoolSearchMapToggle.cshtml")

            <div id="listView">
                @await Html.PartialAsync("~/Views/SchoolSearch/_SchoolSearchResults.cshtml", Model.Results, new ViewDataDictionary(ViewData)
                {
                    { ViewDataKeys.StartItem, Model.Pagination.StartItem },
                    { ViewDataKeys.EndItem, Model.Pagination.EndItem },
                    { ViewDataKeys.TotalResults, Model.TotalResults }
                })

                @await Html.PartialAsync("~/Views/SchoolSearch/_Pagination.cshtml", Model.Pagination)
            </div>

            <div id="mapView" class="govuk-!-display-none">
                @await Html.PartialAsync("~/Views/SchoolSearch/_SchoolSearchMap.cshtml", Model.AllResults)
            </div>
        }
        else
        {
            <p class="govuk-body" id="no-schools-message">
                We could not find any schools for @Model.OrganisationName.
            </p>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/school-search-toggle.js"></script>
    <script src="~/js/map-schools.js"></script>
    <script src="~/js/leaflet.js"></script>
    <script src="~/js/leaflet.markercluster.js"></script>
}
