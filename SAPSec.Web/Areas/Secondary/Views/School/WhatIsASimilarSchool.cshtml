@using SAPSec.Core.Features.SchoolDetails
@using SAPSec.Web.Constants;
@using SAPSec.Web.Helpers
@using SAPSec.Web.Areas.Shared.ViewModels;

@model SchoolInfoViewModel
@{
    Layout = "_Layout";
    ViewData[ViewDataKeys.Title] = "What is a similar school?";
}

<span class="govuk-caption-xl">@Model.Name</span>
<h1 class="govuk-heading-xl">@ViewData[ViewDataKeys.Title]</h1>

<p class="govuk-body">
    We identify <strong>50</strong> similar phase schools for each school phase using a range of characteristics.
</p>

<p class="govuk-body">
    While schools may not match on every characteristic, they are included because they share many similarities.
</p>

<p class="govuk-body">
    You can <a href="@SAPSec.Web.Constants.Routes.SecondarySchool(Model.Urn).ViewSimilarSchools" class="govuk-link">view all the schools most similar to this one</a> and select an individual school to see its similarity, performance and contact details
</p>

<h2 class="govuk-heading-m govuk-!-padding-top-6">Characteristics used to find similar schools</h2>

<h2 class="govuk-heading-m govuk-!-padding-top-6">Prior attainment</h2>

<table class="govuk-table">
    <tbody class="govuk-table__body"> 
    <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold govuk-!-width-one-third">KS4 prior attainment</td>
        <td class="govuk-table__cell">The key stage 4 (KS 4) model uses a key stage 2 (KS2) reading and maths combined measure.</td>
    </tr>
    <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">KS2 prior attainment</td>
        <td class="govuk-table__cell">The KS2 model uses key stage 1 (KS1) test scores.</td>
    </tr>
    </tbody>
</table>

<h2 class="govuk-heading-m govuk-!-padding-top-6">Disadvantage</h2>

<table class="govuk-table">
    <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold govuk-!-width-one-third">Disadvantaged</td>
            <td class="govuk-table__cell">Percentage of pupils eligible for free school meals at any time during the past 6 years.</td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">IDACI</td>
            <td class="govuk-table__cell">Proportion of children aged 0 to 15 who live in income-deprived families in an area.</td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">POLAR4 quintile</td>
            <td class="govuk-table__cell">Average Participation of Local Areas (POLAR4) quitile: area across the UK grouped into quintiles based on the proportion of young
                                                      people who enter higher education, reflecting differences in education opportunity and aspiration.
            <br>
            Find out more about POLAR4 on the Office for Students website (opens in new tab)
            </td>
        </tr>
    </tbody>
</table>

<h2 class="govuk-heading-m govuk-!-padding-top-6">Pupil cohort information</h2>

<table class="govuk-table">
    <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold govuk-!-width-one-third">Total number of pupils</td>
            <td class="govuk-table__cell">Total number of pupils on roll (all ages)</td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">Pupils stability rate</td>
            <td class="govuk-table__cell">Percentage of pupils admitted to the school at the standard time of admission.</td>
        </tr>
    </tbody>
</table>

<h2 class="govuk-heading-m govuk-!-padding-top-6">Inclusion</h2>

<table class="govuk-table">
    <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold govuk-!-width-one-third">EHC plan</td>
            <td class="govuk-table__cell">Percentage of pupils who have an education, health and care (EHC) plan.</td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">SEN support</td>
            <td class="govuk-table__cell">Percentage of pupils who have SEN support without an EHC plan.</td>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">EAL</td>
            <td class="govuk-table__cell">Percentage of pupils who have English as an additional lanuage.</td>
        </tr>
        </tr>
    </tbody>
</table>

<h2 class="govuk-heading-m govuk-!-padding-top-6">Which schools have been identified as similar?</h2>

<p class="govuk-body">
   We use the DfE and Ofsted model for attainment to identify similar schools.
</p>

<p class="govuk-body">
    The model provides information to help understand how well pupils are achieving compared to pupils in schools that have a similar context. The model
    identifies similar schools using factors known to influence attainment.
</p>

<p class="govuk-body">
    You can <a href="@SAPSec.Web.Constants.Routes.SecondarySchool(Model.Urn).ViewSimilarSchools" class="govuk-link">Find out more about the similar model for attainment (open in new tab)</a>
</p>

<h2 class="govuk-heading-m govuk-!-padding-top-6">Annual updates to similar schools data</h2>

<p class="govuk-body">
    As school characteristics such as levels of disadvantage and SEN support change over time, the group of similar
    schools you are matched with will be updated annually.
</p>

<p class="govuk-body">
    When this update occurs, the current year average and year by year average for similar schools will also change to show
    data only from the newest set of similar schools.
</p>
