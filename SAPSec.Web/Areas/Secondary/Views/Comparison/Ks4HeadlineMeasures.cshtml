@using SAPSec.Core.Model
@using SAPSec.Web.ViewModels
@using SAPSec.Web.Constants 

@model SAPSec.Web.Areas.Secondary.ViewModels.Comparison.Ks4HeadlineMeasuresPageViewModel
@{
    Layout = "_Layout";
}

<h2 class="govuk-heading-l">KS4 headline performance measures</h2>

<p class="govuk-body">
    How @Model.CurrentSchool.Name compares with @Model.ComparatorSchool.Name based on KS4 headline performance measures.
</p>

<form action="" method="get">
    <partial name="~/Views/Shared/_Ks4Progress8Info.cshtml" />

    <section class="app-measure-section" aria-labelledby="attainment8-heading">
        <h2 class="govuk-heading-m" id="attainment8-heading" data-testid="attainment8-heading">@Model.Attainment8.MeasureInfo.Name</h2>

        <partial name="~/Views/Shared/_Ks4Attainment8Intro.cshtml" />

        <partial name="Measures/_Measure" model=@Model.Attainment8 />
    </section>

    <section class="app-measure-section" aria-labelledby="eng-maths-heading">
        <h2 class="govuk-heading-m" id="eng-maths-heading" data-testid="eng-maths-heading">@Model.EnglishMaths.MeasureInfo.Name</h2>

        <partial name="Measures/_Measure" model=@Model.EnglishMaths />
    </section>

    <section class="app-measure-section" aria-labelledby="destinations-heading">
        <h2 class="govuk-heading-m" id="destinations-heading" data-testid="destinations-heading">@Model.Destinations.MeasureInfo.Name</h2>

        <details class="govuk-details app-measure-details" data-module="govuk-details">
            <summary class="govuk-details__summary">
                <span class="govuk-details__summary-text">Information about staying in education or entering employment data</span>
            </summary>
            <div class="govuk-details__text">
                <p class="govuk-body-s govuk-!-margin-bottom-2">
                    This data shows the number of pupils who either stayed in education, started an apprenticeship, or entered employment for at least 2 terms after completing KS4.
                </p>
                <p class="govuk-body-s govuk-!-margin-bottom-2">
                    The most recent data covers pupils who finished year 11 in @(Model.Destinations.MeasureInfo.Year + 1). Results are shown for @AcademicYearLabelConfig.FormatAcademicYear(Model.Destinations.MeasureInfo.Year).
                </p>
            </div>
        </details>

        <partial name="Measures/_Measure" model=@Model.Destinations />
    </section>
</form>

@section Scripts {
    <script src="~/js/chart.umd.js" asp-append-version="true" add-nonce="true"></script>
    <script src="~/js/chartjs-plugin-datalabels.min.js" asp-append-version="true" add-nonce="true"></script>
    <script type="module" add-nonce="true">
        import * as MeasureFilters from '/js/measure-filters.js'
        import * as ChartFactory from '/js/chart-factory.js'
        import * as ContentToggle from '/js/content-toggle.js'

        MeasureFilters.initAll();
        ChartFactory.initAll();
        ContentToggle.initAll();
    </script>
}
