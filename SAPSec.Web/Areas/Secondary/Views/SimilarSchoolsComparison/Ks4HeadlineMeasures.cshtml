@using System.Text.Json
@using SAPSec.Web.Constants
@model SAPSec.Web.ViewModels.SimilarSchoolsComparisonViewModel
@{
    Layout = "_Layout";
    ViewData[ViewDataKeys.Title] = $"KS4 headline performance measures compared to {Model.SimilarSchoolName}";
    var ks4YearLabels = SAPSec.Web.ViewModels.AcademicYearLabelConfig.YearByYear;
    var ks4CurrentYear = SAPSec.Web.ViewModels.AcademicYearLabelConfig.CurrentKs4;
    var destinationsYearLabels = SAPSec.Web.ViewModels.AcademicYearLabelConfig.DestinationsYearByYear;
    var destinationsCurrentYear = SAPSec.Web.ViewModels.AcademicYearLabelConfig.CurrentDestinations;
    var chartColors = new[] { "#ca357c", "#2a1950", "#2a1950" };
    var yearByYearColors = new[] { "#ca357c", "#2a1950", "#4b9b7d" };
    const string schoolPointStyle = "triangle";
    const string similarSchoolPointStyle = "circle";
    const string englandPointStyle = "rectRot";
    bool HasAnyData(IEnumerable<decimal?> values) => values.Any(v => v.HasValue);
}

<h1 class="govuk-heading-l">KS4 headline performance measures</h1>

<p class="govuk-body">
    How @Model.Name compares with @Model.SimilarSchoolName based on KS4 headline performance measures.
</p>

<partial name="~/Views/Shared/_Ks4Progress8Info.cshtml" />


@section Scripts {
    <script src="~/js/chart.umd.js" asp-append-version="true" add-nonce="true"></script>
    <script src="~/js/chartjs-plugin-datalabels.min.js" asp-append-version="true" add-nonce="true"></script>
    <script type="module" add-nonce="true">
        import * as ChartFactory from '/js/chart-factory.js'
        import * as ContentToggle from '/js/content-toggle.js'

        ChartFactory.initAll();
        ContentToggle.initAll();
    </script>
    <script src="~/js/data-view-switcher.js" asp-append-version="true" add-nonce="true"></script>
}

<section aria-labelledby="attainment8-heading" class="app-measure-section">
    <h2 class="govuk-heading-m" id="attainment8-heading" data-testid="attainment8-heading">Attainment 8</h2>
    
    <partial name="~/Views/Shared/_Ks4Attainment8Intro.cshtml" />

    <div class="govuk-tabs app-measure-tabs" data-module="govuk-tabs">
        <ul class="govuk-tabs__list">
            <li class="govuk-tabs__list-item govuk-tabs__list-item--selected">
                <a class="govuk-tabs__tab" href="#charts">Charts</a>
            </li>
            <li class="govuk-tabs__list-item">
                <a class="govuk-tabs__tab" href="#table-view">Table</a>
            </li>
        </ul>

        <div class="govuk-tabs__panel" id="charts">
            <content-toggle>
                <toggle-content id="three-year-average" name="@ks4CurrentYear" active="true">
                    @{
                        var chartData = new
                        {
                            labels = new[]
                            {
                                Model.Name,
                                Model.SimilarSchoolName,
                                "Schools in England average"
                            },
                            data = new decimal?[]
                            {
                                Model.ThisSchoolAttainment8YearByYear?.Current,
                                Model.SelectedSchoolAttainment8YearByYear?.Current,
                                Model.EnglandAttainment8YearByYear?.Current
                            }
                        };
                    }
                    <div class="app-measure-chart-container">
                        @if (HasAnyData(chartData.data))
                        {
                            <canvas id="ks4-attainment8-comparison-chart"
                                    class="js-chart"
                                    data-type="bar"
                                    data-show-no-data-labels="true"
                                    data-axis-step="30"
                                    data-axis-max="90"
                                    data-label-decimals="1"
                                    data-bar-thickness="50"
                                    data-category-percentage="0.7"
                                    data-bar-percentage="1"
                                    data-axis-suffix=""
                                    data-chart='@Html.Raw(JsonSerializer.Serialize(chartData))'
                                    data-colors='@Html.Raw(JsonSerializer.Serialize(chartColors))'>
                            </canvas>
                        }
                        else
                        {
                            <p class="govuk-body">No available data</p>
                        }
                    </div>
                </toggle-content>
                <toggle-content id="year-by-year" name="Year by year">
                    @{
                        var yearByYearData = new
                        {
                            labels = ks4YearLabels,
                            datasets = new object[]
                            {
                                new
                                {
                                    label = Model.Name,
                                    borderWidth = 2,
                                    pointRadius = 4,
                                    pointHoverRadius = 5,
                                    pointStyle = schoolPointStyle,
                                    tension = 0,
                                    data = new decimal[]
                                    {
                                        Model.ThisSchoolAttainment8YearByYear?.Previous2 ?? 0m,
                                        Model.ThisSchoolAttainment8YearByYear?.Previous ?? 0m,
                                        Model.ThisSchoolAttainment8YearByYear?.Current ?? 0m
                                    }
                                },
                                new
                                {
                                    label = Model.SimilarSchoolName,
                                    borderWidth = 2,
                                    pointRadius = 4,
                                    pointHoverRadius = 5,
                                    pointStyle = similarSchoolPointStyle,
                                    tension = 0,
                                    data = new decimal[]
                                    {
                                        Model.SelectedSchoolAttainment8YearByYear?.Previous2 ?? 0m,
                                        Model.SelectedSchoolAttainment8YearByYear?.Previous ?? 0m,
                                        Model.SelectedSchoolAttainment8YearByYear?.Current ?? 0m
                                    }
                                },
                                new
                                {
                                    label = "Schools in England average",
                                    borderWidth = 2,
                                    borderColor = yearByYearColors[2],
                                    backgroundColor = yearByYearColors[2],
                                    pointRadius = 4,
                                    pointHoverRadius = 5,
                                    pointStyle = englandPointStyle,
                                    tension = 0,
                                    data = new decimal[]
                                    {
                                        Model.EnglandAttainment8YearByYear?.Previous2 ?? 0m,
                                        Model.EnglandAttainment8YearByYear?.Previous ?? 0m,
                                        Model.EnglandAttainment8YearByYear?.Current ?? 0m
                                    }
                                }
                            }
                        };
                    }
                    <div class="app-measure-chart-container">
                        <canvas id="ks4-attainment8-comparison-yearbyyear-chart"
                                class="js-chart"
                                data-type="line"
                                data-axis-min="0"
                                data-axis-step="30"
                                data-axis-max="90"
                                data-axis-auto-skip="false"
                                data-axis-suffix=""
                                data-tooltip-decimals="1"
                                data-show-x-grid="true"
                                data-show-legend="true"
                                data-show-datalabels="false"
                                data-chart='@Html.Raw(JsonSerializer.Serialize(yearByYearData))'
                                data-colors='@Html.Raw(JsonSerializer.Serialize(yearByYearColors))'>
                        </canvas>
                    </div>
                </toggle-content>
            </content-toggle>
        </div>

        <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="table-view">
            <table class="govuk-table">
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header">School(s)</th>
                        <th scope="col" class="govuk-table__header govuk-table__header--numeric">@ks4YearLabels[0]</th>
                        <th scope="col" class="govuk-table__header govuk-table__header--numeric">@ks4YearLabels[1]</th>
                        <th scope="col" class="govuk-table__header govuk-table__header--numeric">@ks4YearLabels[2]</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">@Model.Name</th>
                        <td class="govuk-table__cell govuk-table__cell--numeric">@SAPSec.Web.ViewModels.SimilarSchoolsComparisonViewModel.DisplayValue(Model.ThisSchoolAttainment8YearByYear?.Previous2)</td>
                        <td class="govuk-table__cell govuk-table__cell--numeric">@SAPSec.Web.ViewModels.SimilarSchoolsComparisonViewModel.DisplayValue(Model.ThisSchoolAttainment8YearByYear?.Previous)</td>
                        <td class="govuk-table__cell govuk-table__cell--numeric">@SAPSec.Web.ViewModels.SimilarSchoolsComparisonViewModel.DisplayValue(Model.ThisSchoolAttainment8YearByYear?.Current)</td>
                    </tr>
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">@Model.SimilarSchoolName</th>
                        <td class="govuk-table__cell govuk-table__cell--numeric">@SAPSec.Web.ViewModels.SimilarSchoolsComparisonViewModel.DisplayValue(Model.SelectedSchoolAttainment8YearByYear?.Previous2)</td>
                        <td class="govuk-table__cell govuk-table__cell--numeric">@SAPSec.Web.ViewModels.SimilarSchoolsComparisonViewModel.DisplayValue(Model.SelectedSchoolAttainment8YearByYear?.Previous)</td>
                        <td class="govuk-table__cell govuk-table__cell--numeric">@SAPSec.Web.ViewModels.SimilarSchoolsComparisonViewModel.DisplayValue(Model.SelectedSchoolAttainment8YearByYear?.Current)</td>
                    </tr>
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">Schools in England average</th>
                        <td class="govuk-table__cell govuk-table__cell--numeric">@SAPSec.Web.ViewModels.SimilarSchoolsComparisonViewModel.DisplayValue(Model.EnglandAttainment8YearByYear?.Previous2)</td>
                        <td class="govuk-table__cell govuk-table__cell--numeric">@SAPSec.Web.ViewModels.SimilarSchoolsComparisonViewModel.DisplayValue(Model.EnglandAttainment8YearByYear?.Previous)</td>
                        <td class="govuk-table__cell govuk-table__cell--numeric">@SAPSec.Web.ViewModels.SimilarSchoolsComparisonViewModel.DisplayValue(Model.EnglandAttainment8YearByYear?.Current)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

