@using SAPSec.Web.Areas.Primary.ViewModels
@model PrimarySimilarSchoolsPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "View similar schools";
    var hasVisibleResults = Model.SimilarSchools.Any();
}

<span class="govuk-caption-xl">@Model.CurrentSchool.Name</span>
<h1 class="govuk-heading-xl">@ViewData["Title"]</h1>

<p class="govuk-body">
    We've identified <strong>@Model.TotalResults</strong> similar primary phase schools for this school.
</p>
<p class="govuk-body">
    Select a school to compare characteristics in more detail and find the best match for peer learning.
</p>
<p class="govuk-body">
    Find out <a href="@Routes.PrimarySchool(Model.CurrentSchool.Urn).WhatIsASimilarSchool" class="govuk-link">how DfE identifies what a similar school is</a>.
</p>

<div class="govuk-grid-row app-similar-schools-content">
    <partial name="SimilarSchoolsFilter.cshtml" model="Model" />

    <div class="govuk-grid-column-two-thirds app-filter__results-column">
        @if (hasVisibleResults)
        {
            <div id="listView">
                <partial name="SimilarSchoolsResults.cshtml" model="Model" />
                <partial name="SimilarSchoolsPagination.cshtml" model="Model" />
            </div>

            <div id="mapView" class="govuk-!-display-none">
                <partial name="SimilarSchoolsMap.cshtml" model="Model" />
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/school-search-toggle.js"></script>
}
