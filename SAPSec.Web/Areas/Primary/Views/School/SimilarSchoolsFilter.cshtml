@using SAPSec.Web.Areas.Primary.ViewModels
@model PrimarySimilarSchoolsPageViewModel

@{
    var hasActiveFilters = Model.HasActiveFilters;
    var isExpanded = hasActiveFilters ? "true" : "false";
    var panelVisibleClass = hasActiveFilters ? "app-filter-panel--visible" : "";
}

<div class="govuk-grid-column-one-third app-filter__column">
    <button type="button" class="govuk-button govuk-button--secondary app-filter-toggle"
            data-module="app-filter-toggle"
            aria-expanded="@isExpanded"
            aria-controls="app-filter-panel">
        <span class="app-filter-toggle__show">Show filters</span>
        <span class="app-filter-toggle__hide">Hide filters</span>
    </button>

    <form method="get"
          action="@Routes.PrimarySchool(Model.CurrentSchool.Urn).ViewSimilarSchools"
          id="app-filter-panel"
          class="app-filter-panel @panelVisibleClass">

        <div class="moj-filter app-filter" data-testid="primary-similar-schools-filter">
            <div class="moj-filter__header app-filter__header">
                <div class="moj-filter__header-title">
                    <h2 class="govuk-heading-m">Filters</h2>
                </div>
            </div>

            <div class="moj-filter__content">
                @if (hasActiveFilters)
                {
                    <div class="moj-filter__selected app-filter__selected">
                        <div class="moj-filter__selected-heading app-filter__selected-heading">
                            <div class="moj-filter__heading-title">
                                <h2 class="govuk-heading-s">Selected filters</h2>
                            </div>
                        </div>

                        @if (Model.SelectedFilterTags.Any())
                        {
                            <ul class="moj-filter-tags app-filter__tags">
                                @foreach (var tag in Model.SelectedFilterTags)
                                {
                                    <li>
                                        <a class="moj-filter__tag app-filter__tag" href="@tag.RemoveUrl">
                                            <span class="govuk-visually-hidden">Remove this filter</span> @tag.Label
                                        </a>
                                    </li>
                                }
                            </ul>
                        }

                        <p class="govuk-!-margin-top-2 govuk-!-margin-bottom-0 app-clear-filters-spacing">
                            <a class="govuk-link govuk-link--no-visited-state"
                               href="@Routes.PrimarySchool(Model.CurrentSchool.Urn).ViewSimilarSchools">
                                Clear filters
                            </a>
                        </p>
                    </div>
                }

                <div class="moj-filter__options app-filter__options">
                    <button type="submit" class="govuk-button app-filter__apply-button" data-module="govuk-button">
                        <span class="app-button-spinner" aria-hidden="true"></span>
                        <span class="app-button-text">Apply filters</span>
                    </button>

                    @foreach (var group in Model.FilterGroups)
                    {
                        <fieldset class="govuk-fieldset app-filter__fieldset">
                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">@group.Heading</legend>
                            @for (var i = 0; i < group.Filters.Count; i++)
                            {
                                var filter = group.Filters[i];
                                var isLastInGroup = i == group.Filters.Count - 1;
                                <partial name="~/Views/SimilarSchools/SimilarSchoolsFilterSection.cshtml"
                                         model="filter"
                                         view-data='new ViewDataDictionary(ViewData) { ["IsLastInGroup"] = isLastInGroup }' />
                            }
                        </fieldset>
                    }

                    <button type="submit" class="govuk-button app-filter__apply-button" data-module="govuk-button">
                        <span class="app-button-spinner" aria-hidden="true"></span>
                        <span class="app-button-text">Apply filters</span>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
