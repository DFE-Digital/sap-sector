@using SAPSec.Core.Model
@using SAPSec.Web.ViewModels

@model SAPSec.Web.Areas.Primary.ViewModels.AttendanceMeasuresPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Attendance measures";
}

<div class="app-school-page">
    <span class="govuk-caption-xl">@Model.School.Name</span>
    <h1 class="govuk-heading-xl">@ViewData["Title"]</h1>

    <p class="govuk-body">
        Compare this school's attendance measures with:
    </p>

    <ul class="govuk-list govuk-list--bullet">
        @* <li><b>50</b> similar primary phase schools (including all-throughs)</li> *@
        <li>the local authority average</li>
        <li>the national average</li>
    </ul>

    <p class="govuk-body">
        Find out <a href="@Routes.PrimarySchool(Model.School.Urn).WhatIsASimilarSchool" class="govuk-link">how DfE defines what a similar school is</a>.
    </p>

    <form action="" method="get">
        <partial name="_AttendanceInfo" />

        <section class="app-measure-section" aria-labelledby="attendance-heading">
            <h2 class="govuk-heading-m" id="attendance-heading" data-testid="attendance-heading">Attendance</h2>

          @*   <details class="govuk-details app-measure-copy app-measure-details" data-module="govuk-details">
                <summary class="govuk-details__summary">
                    <span class="govuk-details__summary-text">Information about meeting the expected standard</span>
                </summary>
                <div class="govuk-details__text">
                    <p class="govuk-body-s govuk-!-margin-bottom-2">
                        Pupils achieve the expected standard when they achieve a scaled score of 100 or more
                        in reading and maths tests, and are assessed by their teacher in writing as &lsquo;working at
                        the expected standard&rsquo; or &lsquo;working at greater depth&rsquo;.
                    </p>
                </div>
            </details> *@


         @*    From here, see how model.attendance is passed to the partial, and have a look a the existing secondary attendance page
               as it used the new usecase
         *@
            <partial name="Measures/_Measure" model=@Model.Attendance />
        </section>
    </form>
</div>

@section Scripts {
    <script src="~/js/chart.umd.js" asp-append-version="true" add-nonce="true"></script>
    <script src="~/js/chartjs-plugin-datalabels.min.js" asp-append-version="true" add-nonce="true"></script>
    <script type="module" add-nonce="true">
        import * as ChartFactory from '/js/chart-factory.js'

        ChartFactory.initAll();
    </script>
    <script src="~/js/data-view-switcher.js" asp-append-version="true" add-nonce="true"></script>
    <script src="~/js/content-toggle.js" asp-append-version="true" add-nonce="true"></script>
}



