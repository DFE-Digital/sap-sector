                                    data-type="bar"
                                    data-show-no-data-labels="true"
                                    data-axis-step="25"
                                    data-axis-max="100"
                                    data-axis-suffix="%"
                                    data-label-decimals="0"
                                    data-bar-thickness="50"
                                    data-category-percentage="0.7"
                                    data-bar-percentage="1"
                                    data-chart='@Html.Raw(JsonSerializer.Serialize(higherRwmChartData))'
                                    data-colors='@Html.Raw(JsonSerializer.Serialize(chartColors))'>
                            </canvas>
                        }
                        else
                        {
                            <p class="govuk-body">No available data</p>
                        }
                    </div>
                </toggle-content>
                <toggle-content id="higher-rwm-year-by-year" name="Year by year">
                    @{
                        var higherRwmYearByYearData = new
                        {
                            labels = ks2YearLabels,
                            datasets = new object[]
                            {
                                new
                                {
                                    label = Model.Name,
                                    borderWidth = 2,
                                    pointRadius = 4,
                                    pointHoverRadius = 5,
                                    tension = 0,
                                    data = new decimal?[]
                                    {
                                        thisSchoolHigherRwm?.Previous2,
                                        thisSchoolHigherRwm?.Previous,
                                        thisSchoolHigherRwm?.Current
                                    }
                                },
                                new
                                {
                                    label = Model.SimilarSchoolName,
                                    borderWidth = 2,
                                    pointRadius = 4,
                                    pointHoverRadius = 5,
                                    tension = 0,
                                    data = new decimal?[]
                                    {
                                        similarSchoolHigherRwm?.Previous2,
                                        similarSchoolHigherRwm?.Previous,
                                        similarSchoolHigherRwm?.Current
                                    }
                                },
                                new
                                {
                                    label = "Schools in England average",
                                    borderWidth = 2,
                                    pointRadius = 4,
                                    pointHoverRadius = 5,
                                    tension = 0,
                                    data = new decimal?[]
                                    {
                                        englandHigherRwm?.Previous2,
                                        englandHigherRwm?.Previous,
                                        englandHigherRwm?.Current
                                    }
                                }
                            }
                        };
                    }
                    <div class="app-measure-chart-container">
                        <canvas id="higher-rwm-comparison-yearbyyear-chart"
                                class="js-chart"
                                data-type="line"
                                data-axis-step="25"
                                data-axis-max="100"
                                data-axis-suffix="%"
                                data-tooltip-decimals="0"
                                data-show-legend="true"
                                data-show-datalabels="false"
                                data-show-x-grid="true"
                                data-chart='@Html.Raw(JsonSerializer.Serialize(higherRwmYearByYearData))'
                                data-colors='@Html.Raw(JsonSerializer.Serialize(yearByYearColors))'>
                        </canvas>
                    </div>
                </toggle-content>
            </content-toggle>
        </div>

        <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="higher-rwm-table-view">
            <table class="govuk-table">
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header">School(s)</th>
                        <th scope="col" class="govuk-table__header govuk-table__header--numeric">@ks2YearLabels[0]</th>
                        <th scope="col" class="govuk-table__header govuk-table__header--numeric">@ks2YearLabels[1]</th>
                        <th scope="col" class="govuk-table__header govuk-table__header--numeric">@ks2YearLabels[2]</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">@Model.Name</th>
                        <td class="govuk-table__cell govuk-table__cell--numeric" data-higher-rwm-cell="this-prev2">@SimilarSchoolsComparisonViewModel.DisplayWholePercent(thisSchoolHigherRwm?.Previous2)</td>
                        <td class="govuk-table__cell govuk-table__cell--numeric" data-higher-rwm-cell="this-prev">@SimilarSchoolsComparisonViewModel.DisplayWholePercent(thisSchoolHigherRwm?.Previous)</td>
                        <td class="govuk-table__cell govuk-table__cell--numeric" data-higher-rwm-cell="this-current">@SimilarSchoolsComparisonViewModel.DisplayWholePercent(thisSchoolHigherRwm?.Current)</td>
                    </tr>
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">@Model.SimilarSchoolName</th>
                        <td class="govuk-table__cell govuk-table__cell--numeric" data-higher-rwm-cell="similar-prev2">@SimilarSchoolsComparisonViewModel.DisplayWholePercent(similarSchoolHigherRwm?.Previous2)</td>
                        <td class="govuk-table__cell govuk-table__cell--numeric" data-higher-rwm-cell="similar-prev">@SimilarSchoolsComparisonViewModel.DisplayWholePercent(similarSchoolHigherRwm?.Previous)</td>
                        <td class="govuk-table__cell govuk-table__cell--numeric" data-higher-rwm-cell="similar-current">@SimilarSchoolsComparisonViewModel.DisplayWholePercent(similarSchoolHigherRwm?.Current)</td>
                    </tr>
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">Schools in England average</th>
                        <td class="govuk-table__cell govuk-table__cell--numeric" data-higher-rwm-cell="england-prev2">@SimilarSchoolsComparisonViewModel.DisplayWholePercent(englandHigherRwm?.Previous2)</td>
                        <td class="govuk-table__cell govuk-table__cell--numeric" data-higher-rwm-cell="england-prev">@SimilarSchoolsComparisonViewModel.DisplayWholePercent(englandHigherRwm?.Previous)</td>
                        <td class="govuk-table__cell govuk-table__cell--numeric" data-higher-rwm-cell="england-current">@SimilarSchoolsComparisonViewModel.DisplayWholePercent(englandHigherRwm?.Current)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/chart.umd.js" asp-append-version="true" add-nonce="true"></script>
    <script src="~/js/chartjs-plugin-datalabels.min.js" asp-append-version="true" add-nonce="true"></script>
    <script type="module" add-nonce="true">
        import * as ChartFactory from '/js/chart-factory.js'
        import * as ContentToggle from '/js/content-toggle.js'

        ChartFactory.initAll();
        ContentToggle.initAll();
    </script>
    <script src="~/js/data-view-switcher.js" asp-append-version="true" add-nonce="true"></script>
}
