@using SAPSec.Web.Constants
@using SAPSec.Web.Areas.Primary.ViewModels

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var comparisonModel = ViewData["ComparisonSchool"] as PrimarySimilarSchoolsComparisonViewModel;

    var currentAction = (string?)ViewContext.RouteData.Values["action"];

    string active(bool condition) => condition ? "govuk-service-navigation__item--active" : "";
}

@section Breadcrumbs {
    <nav class="govuk-breadcrumbs govuk-breadcrumbs--collapse-on-mobile school-comparison-breadcrumb" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item">
                <a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "SchoolSearch")">Home</a>
            </li>
            <li class="govuk-breadcrumbs__list-item">
                <a class="govuk-breadcrumbs__link"
                   href="@Routes.PrimarySchool(comparisonModel!.Urn).ViewSimilarSchools">
                    View similar schools
                </a>
            </li>
        </ol>
    </nav>
}

<div class="govuk-grid-row">

    @* LEFT: back link *@
    <div class="app-side-navigation-container">
        <a class="govuk-back-link"
           href="@Routes.PrimarySchool(comparisonModel!.Urn).ViewSimilarSchools">
            Back
        </a>
    </div>

    @* MAIN CONTENT *@
    <div class="app-body-container-with-side-navigation">
        <span class="govuk-caption-xl">
            @comparisonModel!.Name
        </span>

        <span
            class="govuk-caption-m govuk-!-font-size-24 govuk-!-font-weight-bold govuk-!-padding-top-1 govuk-!-padding-bottom-1">
            Comparing to
        </span>

        <h1 class="govuk-heading-xl">
            @comparisonModel.SimilarSchoolName
        </h1>

        <div class="govuk-service-navigation compare-nav">
            <div class="govuk-service-navigation__container">
                <nav aria-label="Compare sections" class="govuk-service-navigation__wrapper">
                    <ul class="govuk-service-navigation__list">

                        <li class="govuk-service-navigation__item @active(currentAction == "Index" || currentAction == "Similarity")">
                            <a class="govuk-service-navigation__link"
                               href="@Routes.PrimarySchool(comparisonModel.Urn).SimilarSchoolComparison(comparisonModel.SimilarSchoolUrn)"
                               aria-current="@(currentAction == "Index" || currentAction == "Similarity" ? "page" : null)">
                                Similarity
                            </a>
                        </li>

                        <li class="govuk-service-navigation__item @active(currentAction == "Ks2")">
                            <a class="govuk-service-navigation__link"
                               href="@Routes.PrimarySchool(comparisonModel.Urn).SimilarSchoolComparisonKs2(comparisonModel.SimilarSchoolUrn)"
                               aria-current="@(currentAction == "Ks2" ? "page" : null)">
                                KS2
                            </a>
                        </li>

                        <li class="govuk-service-navigation__item @active(currentAction == "Attendance")">
                            <a class="govuk-service-navigation__link"
                               href="@Routes.PrimarySchool(comparisonModel.Urn).SimilarSchoolComparisonAttendance(comparisonModel.SimilarSchoolUrn)"
                               aria-current="@(currentAction == "Attendance" ? "page" : null)">
                                Attendance
                            </a>
                        </li>

                        <li class="govuk-service-navigation__item @active(currentAction == "SchoolDetails")">
                            <a class="govuk-service-navigation__link"
                               href="@Routes.PrimarySchool(comparisonModel.Urn).SimilarSchoolComparisonSchoolDetails(comparisonModel.SimilarSchoolUrn)"
                               aria-current="@(currentAction == "SchoolDetails" ? "page" : null)">
                                School details
                            </a>
                        </li>

                    </ul>
                </nav>
            </div>
        </div>

        <div class="govuk-!-margin-top-9">
            @RenderBody()
        </div>

    </div>
</div>

@await RenderSectionAsync("Scripts", required: false)
