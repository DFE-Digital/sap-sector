@using SAPSec.Web.Constants
@using SAPSec.Web.Areas.Shared.ViewModels
@model RiseResourcesPageViewModel
@{
    Layout = "_Layout";
    ViewData[ViewDataKeys.Title] = PageTitles.RiseResources;
}

@if (!string.IsNullOrWhiteSpace(Model.SchoolName))
{
    <span class="govuk-caption-xl">@Model.SchoolName</span>
}

<h1 class="govuk-heading-xl govuk-!-margin-bottom-6">@ViewData[ViewDataKeys.Title]</h1>

<p class="govuk-body" data-testid="rise-resources-intro">
    Use these resources from RISE to help improve your school&rsquo;s performance.
</p>

@if (!Model.HasResources)
{
    <p class="govuk-body" data-testid="rise-resources-empty">
        No RISE resources are currently available for this school.
    </p>
}
else
{
    var contentsEntries = Model.ContentsEntries.ToList();

    if (contentsEntries.Count > 0)
    {      
        <aside class="part-navigation-container" role="complementary">
            <nav aria-label="Contents" class="gem-c-contents-list govuk-!-margin-bottom-4 govuk-!-margin-top-8" data-testid="rise-resources-contents">
                <h2 class="gem-c-contents-list__title">Contents</h2>
                <ul class="gem-c-contents-list__list">
                    @foreach (var subCategory in contentsEntries)
                    {
                        <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed">
                            <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
                            <a class="gem-c-contents-list__link govuk-link gem-print-force-link-styles" href="#@subCategory.Slug">@subCategory.Name</a>
                        </li>
                    }
                </ul>
            </nav>
        </aside>
    }

    @foreach (var category in Model.Categories)
    {
        if (!string.IsNullOrWhiteSpace(category.Name))
        {
            <h2 class="govuk-heading-l govuk-!-margin-top-8" data-testid="rise-resources-category">@category.Name</h2>
        }

        @if (!string.IsNullOrWhiteSpace(category.Description))
        {
            <p class="govuk-body" data-testid="rise-resources-category-description">@category.Description</p>
        }

        @foreach (var subCategory in category.SubCategories)
        {
            if (!string.IsNullOrWhiteSpace(subCategory.Name))
            {
                <h3 class="govuk-heading-m govuk-!-margin-top-6" id="@subCategory.Slug" tabindex="-1" data-testid="rise-resources-subcategory">@subCategory.Name</h3>
            }

            <ul class="govuk-list" data-testid="rise-resources-list">
                @foreach (var resource in subCategory.Resources)
                {
                    <li class="govuk-!-margin-bottom-6" data-testid="rise-resource">
                        @if (resource.HasLink)
                        {
                            <a class="govuk-link" href="@resource.Url" target="_blank" rel="noopener noreferrer" data-testid="rise-resource-title">@resource.Title</a>
                        }
                        else
                        {
                            <span data-testid="rise-resource-title">@resource.Title</span>
                        }

                        @if (!string.IsNullOrWhiteSpace(resource.Description))
                        {
                            <p class="govuk-body govuk-!-margin-top-1 govuk-!-margin-bottom-0">@resource.Description</p>
                        }
                    </li>
                }
            </ul>
        }
    }
}
