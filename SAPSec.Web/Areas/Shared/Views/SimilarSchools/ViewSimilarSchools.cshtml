@using SAPSec.Web.Areas.Shared.ViewModels.SimilarSchools
@using SAPSec.Web.Constants;

@model SimilarSchoolsPageViewModel
@{
    Layout = "~/Areas/Shared/Views/School/_Layout.cshtml";
    ViewData[ViewDataKeys.Title] = "View similar schools";
    ViewData[ViewDataKeys.PageTitle] = $"{Model.TotalResults} similar schools - {ViewData[ViewDataKeys.Title]}";
}

<link rel="stylesheet" href="~/css/leaflet.css"/>
<link rel="stylesheet" href="~/css/MarkerCluster.css"/>

@if (Model.ValidationErrors.Any())
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">
                There is a problem
            </h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                @foreach (var error in Model.ValidationErrors)
                {
                    <li>
                        @{
                            // If there is an error with both fields in a numeric range filter,
                            // we still need to link to one of the fields, so we choose the From
                            // field.
                            // Note: This will only work as long as numeric range filters are
                            // the only filters with validation errors
                            var key = !error.Key.EndsWith("_f") && !error.Key.EndsWith("_t")
                                ? error.Key + "_f"
                                : error.Key;
                        }
                        <a href="#@(key)">@error.Message</a>
                    </li>
                }
                </ul>
            </div>
        </div>
    </div>
}

<span class="govuk-caption-xl">@Model.SchoolName</span>
<h1 class="govuk-heading-xl">@ViewData[ViewDataKeys.Title]</h1>

<p class="govuk-body">
    We've identified <strong>50</strong> similar @(Model.PhaseLabel) phase schools (including all-throughs).
    Select a school to compare further and connect with for support. You can also refine the results by applying filters.
</p>
<p class="govuk-body">
    Find out <a href="@Model.WhatIsASimilarSchoolUrl" class="govuk-link">how DfE identifies what a similar school is</a>.
</p>

<partial name="_SimilarSchoolsContent" model="Model" />

@section Scripts {
    <script src="~/js/similar-schools-filter.js"></script>
    <script src="~/js/school-search-toggle.js"></script>
    <script src="~/js/map-schools.js"></script>
    <script src="~/js/leaflet.js"></script>
    <script src="~/js/leaflet.markercluster.js"></script>
}
