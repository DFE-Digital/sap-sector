@using SAPSec.Web.Areas.AllThrough.ViewModels
@using SAPSec.Web.Constants

@model AllThroughWhatIsASimilarSchoolViewModel
@{
    Layout = "_Layout";
    ViewData[ViewDataKeys.Title] = "What is a similar school?";
}

<span class="govuk-caption-xl">@Model.School.Name</span>
<h1 class="govuk-heading-xl">@ViewData[ViewDataKeys.Title]</h1>

<p class="govuk-body">
    We identify <strong>50</strong> similar phase schools for each school phase using a range of characteristics.
</p>

<p class="govuk-body">
    While schools may not match on every characteristic, they are included because they share many similarities.
</p>

@if (Model.HasSimilarSchools)
{
    <p class="govuk-body">
        You can <a href="@Model.ViewSimilarSchoolsUrl" class="govuk-link">view all the schools most similar to this one</a> and select an individual school to see its similarity, performance and contact details.
    </p>
}
else
{
    <p class="govuk-body">
        <a href="@Model.OverviewUrl" class="govuk-link">This school cannot currently be compared with similar schools.</a>
    </p>
}

<h2 class="govuk-heading-m govuk-!-padding-top-6">Characteristics used to find similar schools</h2>

<h3 class="govuk-heading-m">Prior attainment</h3>

<table class="govuk-table">
    <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">KS4 prior attainment</td>
            <td class="govuk-table__cell">The key stage 4 (KS4) model uses a key stage 2 (KS2) reading and maths combined measure.</td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">KS2 prior attainment</td>
            <td class="govuk-table__cell">The KS2 model uses key stage 1 (KS1) test scores.</td>
        </tr>
    </tbody>
</table>

<h3 class="govuk-heading-m">Disadvantage</h3>

<table class="govuk-table">
    <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">Ever 6 FSM</td>
            <td class="govuk-table__cell">Percentage of pupils eligible for free school meals at any time during the past 6 years.</td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">IDACI score</td>
            <td class="govuk-table__cell">
                <p class="govuk-body govuk-!-margin-bottom-4">
                    Proportion of children aged 0 to 15 who live in income-deprived families in an area.
                </p>
                <a href="https://www.gov.uk/government/statistics/english-indices-of-deprivation-2025/english-indices-of-deprivation-2025-statistical-release" class="govuk-link" target="_blank" rel="noopener noreferrer">Find out more about English indices of deprivation (opens in new tab)</a>
            </td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">POLAR4 quintile</td>
            <td class="govuk-table__cell">
                <p class="govuk-body govuk-!-margin-bottom-4">
                    Average Participation of Local Areas (POLAR4) quintile: areas across the UK grouped into quintiles based on the proportion of young people who enter higher education, reflecting differences in educational opportunity and aspiration.
                </p>
                <a href="https://www.officeforstudents.org.uk/data-and-analysis/young-participation-by-area/about-polar-and-adult-he/" class="govuk-link" target="_blank" rel="noopener noreferrer">Find out more about POLAR4 on the Office for Students website (opens in new tab)</a>
            </td>
        </tr>
    </tbody>
</table>

<h3 class="govuk-heading-m">Pupil cohort information</h3>

<table class="govuk-table">
    <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">Total number of pupils</td>
            <td class="govuk-table__cell">Total number of pupils on roll (all ages).</td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">Pupil stability rate</td>
            <td class="govuk-table__cell">Percentage of pupils admitted to the school at the standard time of admission.</td>
        </tr>
    </tbody>
</table>

<h3 class="govuk-heading-m">Inclusion</h3>

<table class="govuk-table">
    <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">EHC plan</td>
            <td class="govuk-table__cell">Percentage of pupils who have an education, health and care (EHC) plan.</td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">SEN support</td>
            <td class="govuk-table__cell">Percentage of pupils who have SEN support without an EHC plan.</td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">EAL</td>
            <td class="govuk-table__cell">Percentage of pupils who have English as an additional language.</td>
        </tr>
    </tbody>
</table>

<h2 class="govuk-heading-m govuk-!-padding-top-6">How have these schools been identified as similar?</h2>

<p class="govuk-body">
    We use the DfE and Ofsted model for attainment to identify similar schools.
</p>

<p class="govuk-body">
    The model provides information to help understand how well pupils are achieving compared to pupils in schools that have a similar context. The model identifies similar schools using factors known to influence attainment.
</p>

<p class="govuk-body">
    <a href="https://www.gov.uk/government/publications/similar-schools-model-for-attainment" class="govuk-link" target="_blank" rel="noopener noreferrer">Find out more about the similar schools model for attainment (opens in new tab)</a>
</p>

<h2 class="govuk-heading-m govuk-!-padding-top-6">Annual updates to similar schools data</h2>

<p class="govuk-body">
    As school characteristics such as levels of disadvantage and SEN support change over time, the group of similar schools you are matched with will be updated annually.
</p>

<p class="govuk-body">
    When this update occurs, the current year average and year by year average for similar schools will also change to show data only from the newest set of similar schools.
</p>
