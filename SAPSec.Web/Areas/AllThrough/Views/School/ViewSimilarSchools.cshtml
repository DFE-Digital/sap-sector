@using SAPSec.Web.Areas.AllThrough.ViewModels
@using SAPSec.Web.Constants

@model AllThroughSimilarSchoolsPageViewModel
@{
    Layout = "_Layout";
    ViewData[ViewDataKeys.Title] = "View similar schools";
}

<span class="govuk-caption-xl">@Model.School.Name</span>
<h1 class="govuk-heading-xl">@ViewData[ViewDataKeys.Title]</h1>

<div class="app-all-through-similar-schools">
    <p class="govuk-body">
        We've identified <strong>50</strong> similar primary phase schools (including all-throughs) and
        <strong>50</strong> similar secondary phase schools (including all-throughs). Select primary or
        secondary then choose a school to compare further and connect with for support. You can also
        refine the results by applying filters.
    </p>

    <p class="govuk-body">
        Find out <a href="@Model.WhatIsASimilarSchoolUrl" class="govuk-link">how DfE identifies what a similar school is</a>.
    </p>

    <nav class="app-phase-tabs" aria-label="Similar school phase">
        <ul class="app-phase-tabs__list" role="tablist">
            <li class="app-phase-tabs__list-item @(Model.IsPrimarySelected ? "app-phase-tabs__list-item--selected" : string.Empty)" role="presentation">
                <a class="app-phase-tabs__tab"
                   href="@Model.PrimaryTabUrl"
                   id="tab_primary"
                   role="tab"
                   aria-selected="@(Model.IsPrimarySelected ? "true" : "false")">
                    Primary
                </a>
            </li>
            <li class="app-phase-tabs__list-item @(!Model.IsPrimarySelected ? "app-phase-tabs__list-item--selected" : string.Empty)" role="presentation">
                <a class="app-phase-tabs__tab"
                   href="@Model.SecondaryTabUrl"
                   id="tab_secondary"
                   role="tab"
                   aria-selected="@(!Model.IsPrimarySelected ? "true" : "false")">
                    Secondary
                </a>
            </li>
        </ul>
    </nav>
</div>
